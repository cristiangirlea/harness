{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go list *)",
      "Bash(go doc *)",
      "Bash(go env *)",
      "Bash(go version)",
      "Bash(gofmt -l *)",
      "Bash(gofmt -d *)",
      "Bash(gofmt -w *)",
      "Bash(bash -n *)",
      "Bash(bash .github/release.sh)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git blame *)",
      "Bash(git branch *)",
      "Bash(git worktree list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "ask": [
      "Bash(git tag *)",
      "Bash(gh pr create *)",
      "Bash(hrn run *)",
      "Bash(hrn batch *)",
      "Bash(hrn eval *)",
      "Bash(go run ./cmd/hrn *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --tags *)",
      "Bash(git push origin v*)",
      "Bash(scripts/api-check.sh)",
      "Bash(scripts/api-check.sh *)",
      "Bash(./scripts/api-check.sh)",
      "Bash(./scripts/api-check.sh *)",
      "Bash(bash scripts/api-check.sh)",
      "Bash(bash scripts/api-check.sh *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-rules.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
