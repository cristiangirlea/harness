{{define "head"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Title}} · hrn watch</title>
<link rel="stylesheet" href="/static/watch.css">
<script src="/static/watch.js" defer></script>
{{with .Script}}<script src="/static/{{.}}" defer></script>
{{end}}</head>
<body>
<main>
<header class="top">
<a class="home" href="/">hrn watch</a>
<span id="state" class="state" role="status" aria-live="polite"></span>
</header>
{{end}}

{{define "foot"}}
<footer>{{with .Home}}Reads <span class="mono">{{.}}</span> · {{end}}Loads nothing from other sites</footer>
</main>
</body>
</html>
{{end}}

{{define "facts"}}<dl class="facts">{{range .}}<div><dt>{{.Label}}</dt><dd>{{.Value}}</dd></div>{{end}}</dl>{{end}}

{{define "index"}}{{template "head" .}}
<p class="eyebrow">Harness / live view</p>
<h1>Runs and batches</h1>
<p class="intro">Newest first. The lists update by themselves while hrn works; open a run to follow its steps. A batch's tasks also appear as runs, linked to their batch. <a href="/bot">Ada</a>, the bot, tells you what hrn is doing, out loud if you like.</p>
{{if .Phone}}<section class="card reach" aria-labelledby="reach-h">
<h2 id="reach-h">On your phone</h2>
<p>Scan the code of the network your phone is on, or open its link. On Wi-Fi it is the one on your Wi-Fi adapter; the others are usually virtual adapters (WSL, Hyper-V, Docker), or a VPN that looks like an ordinary adapter. <code>hrn watch --lan=NAME</code> serves just one.</p>
<ul class="phones">{{range .Phone}}<li>{{if .QRPath}}<svg class="qr" viewBox="0 0 {{.QRView}} {{.QRView}}" role="img" aria-label="QR code of {{.URL}}"><rect width="{{.QRView}}" height="{{.QRView}}" fill="#fff"/><path d="{{.QRPath}}" fill="#000"/></svg>{{end}}<span><a class="mono" href="{{.URL}}">{{.URL}}</a><br><span class="muted">{{.Interface}}</span></span></li>{{end}}</ul>
<p class="notice warn">Viewing needs no login: while hrn watch --lan runs, anyone on each of these networks can read your runs. Nothing here can start, stop or merge anything; acting on hrn will need hrn watch's key.</p>
</section>
{{else if .Local}}<p class="muted small">Only this computer can open this page. Run <code>hrn watch --lan</code> to open it from a phone on the same network.</p>{{end}}
<div id="live" data-stream="/stream/index" data-replace>{{template "lists" .Lists}}</div>
{{template "foot" .}}{{end}}

{{define "lists"}}
{{range .Problems}}<p class="notice bad">{{.}}</p>{{end}}
<section class="card" aria-labelledby="batches-h">
<h2 id="batches-h">Batches</h2>
{{if .Batches}}<div class="table-wrap" tabindex="0" role="region" aria-label="Batches"><table class="list">
<thead><tr><th scope="col">Batch</th><th scope="col">Status</th><th scope="col">Tasks</th><th scope="col">Backends</th><th scope="col" class="num">Duration</th><th scope="col" class="num">Cost</th><th scope="col">First task</th></tr></thead>
<tbody>{{range .Batches}}<tr>
<td class="mono"><a href="/batch/{{.ID}}">{{.ID}}</a></td>
<td><span class="badge {{.Class}}">{{.Status}}</span></td>
<td class="meta">{{.Tasks}}</td>
<td class="meta">{{.Backend}}</td>
<td class="num meta">{{template "took" .}}</td>
<td class="num meta">{{.Cost}}</td>
<td class="prompt">{{.Prompt}}</td>
</tr>{{end}}</tbody></table></div>
{{else}}<p class="muted">No batches yet.</p>{{end}}
</section>
<section class="card" aria-labelledby="runs-h">
<h2 id="runs-h">Runs</h2>
{{if .Runs}}<div class="table-wrap" tabindex="0" role="region" aria-label="Runs"><table class="list">
<thead><tr><th scope="col">Run</th><th scope="col">Backend</th><th scope="col">Status</th><th scope="col" class="num">Duration</th><th scope="col" class="num">Cost</th><th scope="col">Prompt</th></tr></thead>
<tbody>{{range .Runs}}<tr>
<td class="mono"><a href="/run/{{.ID}}">{{.ID}}</a>{{with .Batch}}<a class="of-batch" href="/batch/{{.}}">batch {{.}}</a>{{end}}</td>
<td class="meta">{{.Backend}}</td>
<td><span class="badge {{.Class}}">{{.Status}}</span></td>
<td class="num meta">{{template "took" .}}</td>
<td class="num meta">{{.Cost}}</td>
<td class="prompt">{{.Prompt}}</td>
</tr>{{end}}</tbody></table></div>
{{else}}<p class="muted">No runs yet.</p>{{end}}
</section>
{{end}}

{{define "took"}}{{if .Since}}<span data-since="{{.Since}}">{{.Took}}</span>{{else}}{{.Took}}{{end}}{{end}}

{{define "run"}}{{template "head" .}}
<p class="eyebrow">Run <span class="mono">{{.ID}}</span>{{with .Continues}} · continues <a class="mono" href="/run/{{.}}">{{.}}</a>{{end}}</p>
<h1 class="prompt-line">{{.PromptLine}}</h1>
{{if .PromptMore}}<details class="prompt" data-key="prompt"><summary>Whole prompt</summary><pre>{{.Prompt}}</pre></details>{{end}}
{{template "facts" .Facts}}
{{if .Since}}<p class="muted clock">Running for <span data-since="{{.Since}}">a while</span>{{if .Last}} · last step <span data-ago="{{.Last}}">a moment</span> ago{{end}}</p>{{end}}
<ol id="timeline" class="timeline"{{with .Stream}} data-stream="{{.}}"{{end}}>{{range .Events}}{{template "event" .}}{{end}}</ol>
<div id="result">{{with .Result}}{{template "result" .}}{{else}}<p class="muted">Running. New steps appear above as hrn records them.</p>{{end}}</div>
{{template "foot" .}}{{end}}

{{define "event"}}<li class="ev {{.Class}}"{{with .When}} data-at="{{.}}"{{end}}>
<div class="when">{{if .Clock}}<time datetime="{{.When}}">{{.Clock}}</time>{{end}}{{with .Gap}} <span class="gap{{if $.Slow}} slow{{end}}">{{.}}</span>{{end}}</div>
<div class="what">{{if .Text}}<div class="text">{{.Body}}</div>{{with .More}}<p class="more">{{.}}</p>{{end}}
{{else if .Body}}<details><summary><span class="tag">{{.Label}}</span> <span class="sum">{{.Summary}}</span></summary><pre>{{.Body}}</pre>{{with .More}}<p class="more">{{.}}</p>{{end}}</details>
{{else}}<span class="tag">{{.Label}}</span> <span class="sum">{{.Summary}}</span>{{end}}</div>
</li>{{end}}

{{define "result"}}<section class="card result" aria-labelledby="result-h">
<h2 id="result-h">Finished <span class="badge {{.Class}}">{{.Status}}</span></h2>
{{template "facts" .Facts}}
{{with .Error}}<p class="notice bad">{{.}}</p>{{end}}
{{with .Final}}<details data-key="final"><summary>Final answer</summary><div class="text">{{.}}</div>{{with $.FinalMore}}<p class="more">{{.}}</p>{{end}}</details>{{end}}
</section>{{end}}

{{define "batch"}}{{template "head" .}}
<p class="eyebrow">Batch <span class="mono">{{.ID}}</span></p>
<h1>{{.Title}}</h1>
<div id="live"{{with .Stream}} data-stream="{{.}}" data-replace{{end}}>{{template "batchbody" .Body}}</div>
{{template "foot" .}}{{end}}

{{define "batchbody"}}
<p><span class="badge {{.Class}}">{{.Status}}</span>{{with .Since}} · running for <span data-since="{{.}}">a while</span>{{end}}</p>
{{template "facts" .Facts}}
{{range .Tasks}}<section class="card task" aria-labelledby="task-{{.ID}}">
<h2 id="task-{{.ID}}"><span class="mono">{{.ID}}</span> <span class="badge {{.Class}}">{{.Status}}</span></h2>
<p class="prompt-line">{{.PromptLine}}</p>
{{if .PromptMore}}<details data-key="prompt/{{.ID}}"><summary>Whole prompt</summary><pre>{{.Prompt}}</pre></details>{{end}}
{{template "facts" .Facts}}
{{with .Error}}<p class="notice bad">{{.}}</p>{{end}}
{{if .Waiting}}<p class="muted">Waiting for a free worker.</p>{{end}}
{{range .Attempts}}<div class="attempt">
<h3>Attempt {{.N}} · {{.Backend}}{{if .SwitchedFrom}} · moved from {{.SwitchedFrom}} at its usage limit{{end}}{{if .Continued}} · continued in the same worktree{{end}}</h3>
<p>{{if .RunID}}<a class="mono" href="/run/{{.RunID}}">run {{.RunID}}</a> {{end}}<span class="badge {{.Class}}">{{.Status}}</span>{{with .Detail}} · {{.}}{{end}}</p>
{{with .Error}}<p class="notice bad">{{.}}</p>{{end}}
{{if .Gates}}<div class="table-wrap"><table class="gates">
<thead><tr><th scope="col">Gate</th><th scope="col" class="num">Exit</th><th scope="col" class="num">Took</th></tr></thead>
<tbody>{{range .Gates}}<tr>
<td><code>{{.Command}}</code>{{if .Output}}<details data-key="{{.Key}}"><summary>output</summary><pre>{{.Output}}</pre>{{with .More}}<p class="more">{{.}}</p>{{end}}</details>{{end}}</td>
<td class="num"><span class="badge {{.Class}}">{{.Exit}}</span></td>
<td class="num">{{.Took}}</td>
</tr>{{end}}</tbody></table></div>
{{else if .Running}}<p class="muted">The gates run when the agent is done.</p>{{end}}
</div>{{end}}
</section>{{end}}
{{end}}

{{define "problem"}}<p class="notice bad">{{.}}</p>{{end}}

{{define "missing"}}{{template "head" .}}
<h1>Not found</h1>
<p class="notice bad">{{.Message}}</p>
<p><a href="/">Back to the runs and batches</a></p>
{{template "foot" .}}{{end}}

{{define "bot"}}{{template "head" .}}
<section class="card bot" aria-labelledby="bot-h">
<div class="bot-head">
<svg class="bot-face" viewBox="0 0 64 64" aria-hidden="true"><path class="tuft" d="M13 20 L15 5 L26 14 Z"/><path class="tuft" d="M51 20 L49 5 L38 14 Z"/><rect class="shell" x="9" y="12" width="46" height="46" rx="20"/><path class="seam" d="M17 50 h30"/><circle class="rivet" cx="21" cy="54" r="1.2"/><circle class="rivet" cx="43" cy="54" r="1.2"/><circle class="ring" cx="23" cy="31" r="9"/><circle class="ring" cx="41" cy="31" r="9"/><circle class="eye" cx="23" cy="31" r="3.6"/><circle class="eye" cx="41" cy="31" r="3.6"/><path class="lash" d="M15 23 l-3 -3 M18.5 21 l-1.5 -4 M23 20.5 v-4"/><path class="lash" d="M49 23 l3 -3 M45.5 21 l1.5 -4 M41 20.5 v-4"/><path class="mouth beak" d="M28.5 40 h7 l-3.5 5 Z"/></svg>
<div>
<h1 id="bot-h">Ada</h1>
<p id="bot-line" class="bot-line" aria-live="polite">I'm Ada. I'll tell you what hrn is doing.</p>
</div>
</div>
<p class="bot-buttons">
<button type="button" id="bot-wake" class="primary">Let me talk</button>
<button type="button" id="bot-skip" title="Esc">Skip</button>
<button type="button" id="bot-listen" hidden>Talk to me</button>
<label>Snooze <select id="bot-snooze"><option value="0">off</option><option value="15">15 minutes</option><option value="60">an hour</option><option value="-1">until I unmute</option></select></label>
</p>
<p id="bot-quiet" class="muted small" hidden></p>
</section>
<div id="live" data-stream="/stream/bot" data-replace>{{template "botnow" .Now}}</div>
<section class="card" aria-labelledby="said-h"><h2 id="said-h">What I've said</h2><ol id="bot-log" class="bot-log"><li class="muted">Nothing yet.</li></ol></section>
<details class="card" id="bot-settings"><summary>Settings</summary>
<div class="table-wrap"><table><thead><tr><th>When</th><th>Say it</th><th>Notify</th></tr></thead><tbody>
{{range .Kinds}}<tr><td>{{.Label}}</td><td><input type="checkbox" data-kind="{{.Name}}" data-how="speak"{{if .Speak}} checked{{end}} aria-label="Say it: {{.Label}}"></td><td><input type="checkbox" data-kind="{{.Name}}" data-how="notify"{{if .Notify}} checked{{end}} aria-label="Notify: {{.Label}}"></td></tr>
{{end}}</tbody></table></div>
<p class="bot-controls"><label>Voice <select id="bot-voice"></select></label> <label>Speed <input id="bot-rate" type="range" min="0.6" max="1.6" step="0.1" value="1"></label> <button type="button" id="bot-test">Try it</button></p>
<p id="bot-no-uk" class="notice warn" hidden>No British voice is installed on this computer, so I speak British English in another accent. On Windows, the English (United Kingdom) speech pack adds three (Settings, Time and language, Speech, Add voices); or choose an online British voice above, which sends what I say to its maker.</p>
<p><button type="button" id="bot-notify-ask" hidden>Allow notifications</button> <span id="bot-notify-state" class="muted small"></span></p>
<p class="muted small">A voice marked online sends what it says to its maker to be spoken; the ones on this computer do not. Talk to me uses the browser's speech recogniser, which may send what the microphone hears to its maker (Microsoft for Edge, Google for Chrome) while it listens; it listens for one sentence each time you press it. You can say: status, skip, quiet (for an hour, or until I unmute), unmute, repeat. Nothing said here acts on hrn. Settings stay in this browser.</p>
<p id="bot-net" class="notice warn" hidden>Opened over the network: the browser allows neither notifications nor the microphone on this address. Speaking still works.</p>
</details>
{{template "foot" .}}{{end}}

{{define "botnow"}}<section class="card" aria-labelledby="now-h"><h2 id="now-h">Going now</h2>
{{if .Going}}<ul class="bot-now">{{range .Going}}<li data-ref="{{.ID}}"><span class="badge run">{{.Kind}}</span> <a href="{{.URL}}">{{.Who}}{{with .Where}} in {{.}}{{end}}</a> <span class="muted small" data-since="{{.Since}}"></span>{{with .What}}<br><span>{{.}}</span>{{end}}{{with .Doing}}<br><span class="muted">{{.}}</span>{{end}} <button type="button" class="quiet" data-mute="{{.ID}}">Mute this</button></li>
{{end}}</ul>{{else}}<p class="muted">Nothing is running.</p>{{end}}
</section>{{end}}
