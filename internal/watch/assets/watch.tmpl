{{define "head"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Title}} · hrn watch</title>
<link rel="stylesheet" href="/static/watch.css">
<script src="/static/watch.js" defer></script>
</head>
<body>
<main>
<header class="top">
<a class="home" href="/">hrn watch</a>
<span id="state" class="state" role="status" aria-live="polite"></span>
</header>
{{end}}

{{define "foot"}}
<footer>Reads <span class="mono">{{.Home}}</span> · loads nothing from other sites</footer>
</main>
</body>
</html>
{{end}}

{{define "facts"}}<dl class="facts">{{range .}}<div><dt>{{.Label}}</dt><dd>{{.Value}}</dd></div>{{end}}</dl>{{end}}

{{define "index"}}{{template "head" .}}
<p class="eyebrow">Harness / live view</p>
<h1>Runs and batches</h1>
<p class="intro">Newest first. The lists update by themselves while hrn works; open a run to follow its steps.</p>
{{if .LAN}}<section class="card reach" aria-labelledby="reach-h">
<h2 id="reach-h">On your phone</h2>
<p>Open one of these on a device on the same network. On Wi-Fi it is the one on your Wi-Fi adapter; the others are usually virtual adapters (WSL, Hyper-V, Docker), or a VPN that looks like an ordinary adapter.</p>
<ul class="urls">{{range .LAN}}<li><a class="mono" href="{{.URL}}">{{.URL}}</a> <span class="muted">{{.Interface}}</span></li>{{end}}</ul>
<p class="notice warn">No login yet: while hrn watch --lan runs, anyone on each of these networks can read your runs. The page only shows; it cannot start, stop or merge anything.</p>
</section>
{{else}}<p class="muted small">Only this computer can open this page. Run <code>hrn watch --lan</code> to open it from a phone on the same network.</p>{{end}}
<div id="live" data-stream="/stream/index" data-replace>{{template "lists" .Lists}}</div>
{{template "foot" .}}{{end}}

{{define "lists"}}
{{range .Problems}}<p class="notice bad">{{.}}</p>{{end}}
<section class="card" aria-labelledby="batches-h">
<h2 id="batches-h">Batches</h2>
{{if .Batches}}<div class="table-wrap" tabindex="0" role="region" aria-label="Batches"><table>
<thead><tr><th scope="col">Batch</th><th scope="col">Status</th><th scope="col">Tasks</th><th scope="col">Backends</th><th scope="col" class="num">Duration</th><th scope="col" class="num">Cost</th><th scope="col">First task</th></tr></thead>
<tbody>{{range .Batches}}<tr>
<td class="mono"><a href="/batch/{{.ID}}">{{.ID}}</a></td>
<td><span class="badge {{.Class}}">{{.Status}}</span></td>
<td>{{.Tasks}}</td>
<td>{{.Backend}}</td>
<td class="num">{{template "took" .}}</td>
<td class="num">{{.Cost}}</td>
<td class="prompt">{{.Prompt}}</td>
</tr>{{end}}</tbody></table></div>
{{else}}<p class="muted">No batches yet.</p>{{end}}
</section>
<section class="card" aria-labelledby="runs-h">
<h2 id="runs-h">Runs</h2>
{{if .Runs}}<div class="table-wrap" tabindex="0" role="region" aria-label="Runs"><table>
<thead><tr><th scope="col">Run</th><th scope="col">Backend</th><th scope="col">Status</th><th scope="col" class="num">Duration</th><th scope="col" class="num">Cost</th><th scope="col">Prompt</th></tr></thead>
<tbody>{{range .Runs}}<tr>
<td class="mono"><a href="/run/{{.ID}}">{{.ID}}</a></td>
<td>{{.Backend}}</td>
<td><span class="badge {{.Class}}">{{.Status}}</span></td>
<td class="num">{{template "took" .}}</td>
<td class="num">{{.Cost}}</td>
<td class="prompt">{{.Prompt}}</td>
</tr>{{end}}</tbody></table></div>
{{else}}<p class="muted">No runs yet.</p>{{end}}
</section>
{{end}}

{{define "took"}}{{if .Since}}<span data-since="{{.Since}}">{{.Took}}</span>{{else}}{{.Took}}{{end}}{{end}}

{{define "run"}}{{template "head" .}}
<p class="eyebrow">Run <span class="mono">{{.ID}}</span>{{with .Continues}} · continues <a class="mono" href="/run/{{.}}">{{.}}</a>{{end}}</p>
<h1 class="prompt-line">{{.PromptLine}}</h1>
{{if .PromptMore}}<details class="prompt" data-key="prompt"><summary>Whole prompt</summary><pre>{{.Prompt}}</pre></details>{{end}}
{{template "facts" .Facts}}
{{if .Since}}<p class="muted clock">Running for <span data-since="{{.Since}}">a while</span>{{if .Last}} · last step <span data-ago="{{.Last}}">a moment</span> ago{{end}}</p>{{end}}
<ol id="timeline" class="timeline"{{with .Stream}} data-stream="{{.}}"{{end}}>{{range .Events}}{{template "event" .}}{{end}}</ol>
<div id="result">{{with .Result}}{{template "result" .}}{{else}}<p class="muted">Running. New steps appear above as hrn records them.</p>{{end}}</div>
{{template "foot" .}}{{end}}

{{define "event"}}<li class="ev {{.Class}}"{{with .When}} data-at="{{.}}"{{end}}>
<div class="when">{{if .Clock}}<time datetime="{{.When}}">{{.Clock}}</time>{{end}}{{with .Gap}} <span class="gap{{if $.Slow}} slow{{end}}">{{.}}</span>{{end}}</div>
<div class="what">{{if .Text}}<div class="text">{{.Body}}</div>{{with .More}}<p class="more">{{.}}</p>{{end}}
{{else if .Body}}<details><summary><span class="tag">{{.Label}}</span> <span class="sum">{{.Summary}}</span></summary><pre>{{.Body}}</pre>{{with .More}}<p class="more">{{.}}</p>{{end}}</details>
{{else}}<span class="tag">{{.Label}}</span> <span class="sum">{{.Summary}}</span>{{end}}</div>
</li>{{end}}

{{define "result"}}<section class="card result" aria-labelledby="result-h">
<h2 id="result-h">Finished <span class="badge {{.Class}}">{{.Status}}</span></h2>
{{template "facts" .Facts}}
{{with .Error}}<p class="notice bad">{{.}}</p>{{end}}
{{with .Final}}<details data-key="final"><summary>Final answer</summary><div class="text">{{.}}</div>{{with $.FinalMore}}<p class="more">{{.}}</p>{{end}}</details>{{end}}
</section>{{end}}

{{define "batch"}}{{template "head" .}}
<p class="eyebrow">Batch <span class="mono">{{.ID}}</span></p>
<h1>{{.Title}}</h1>
<div id="live"{{with .Stream}} data-stream="{{.}}" data-replace{{end}}>{{template "batchbody" .Body}}</div>
{{template "foot" .}}{{end}}

{{define "batchbody"}}
<p><span class="badge {{.Class}}">{{.Status}}</span>{{with .Since}} · running for <span data-since="{{.}}">a while</span>{{end}}</p>
{{template "facts" .Facts}}
{{range .Tasks}}<section class="card task" aria-labelledby="task-{{.ID}}">
<h2 id="task-{{.ID}}"><span class="mono">{{.ID}}</span> <span class="badge {{.Class}}">{{.Status}}</span></h2>
<p class="prompt-line">{{.PromptLine}}</p>
{{if .PromptMore}}<details data-key="prompt/{{.ID}}"><summary>Whole prompt</summary><pre>{{.Prompt}}</pre></details>{{end}}
{{template "facts" .Facts}}
{{with .Error}}<p class="notice bad">{{.}}</p>{{end}}
{{if .Waiting}}<p class="muted">Waiting for a free worker.</p>{{end}}
{{range .Attempts}}<div class="attempt">
<h3>Attempt {{.N}} · {{.Backend}}{{if .SwitchedFrom}} · moved from {{.SwitchedFrom}} at its usage limit{{end}}{{if .Continued}} · continued in the same worktree{{end}}</h3>
<p>{{if .RunID}}<a class="mono" href="/run/{{.RunID}}">run {{.RunID}}</a> {{end}}<span class="badge {{.Class}}">{{.Status}}</span>{{with .Detail}} · {{.}}{{end}}</p>
{{with .Error}}<p class="notice bad">{{.}}</p>{{end}}
{{if .Gates}}<div class="table-wrap"><table class="gates">
<thead><tr><th scope="col">Gate</th><th scope="col" class="num">Exit</th><th scope="col" class="num">Took</th></tr></thead>
<tbody>{{range .Gates}}<tr>
<td><code>{{.Command}}</code>{{if .Output}}<details data-key="{{.Key}}"><summary>output</summary><pre>{{.Output}}</pre>{{with .More}}<p class="more">{{.}}</p>{{end}}</details>{{end}}</td>
<td class="num"><span class="badge {{.Class}}">{{.Exit}}</span></td>
<td class="num">{{.Took}}</td>
</tr>{{end}}</tbody></table></div>
{{else if .Running}}<p class="muted">The gates run when the agent is done.</p>{{end}}
</div>{{end}}
</section>{{end}}
{{end}}

{{define "problem"}}<p class="notice bad">{{.}}</p>{{end}}

{{define "missing"}}{{template "head" .}}
<h1>Not found</h1>
<p class="notice bad">{{.Message}}</p>
<p><a href="/">Back to the runs and batches</a></p>
{{template "foot" .}}{{end}}
